GITHUB_OWNER=pucj0
GITHUB_REPOSITORY=gbaselite
VERSION=1.0.001
DOCKER_IMAGE=pucj/gbaselite
# 必填：修改为高强度密码。二进制 Compose 未设置该项会拒绝启动。
DB_PASSWORD=change-this-password

# 以下均为可选覆盖项；仅在需要改变默认行为时取消注释并赋值。
# DB_USER=root
# DB_PORT=3307
# DB_DATA_PATH=/app/data
# DB_LOGIN_FAILURE_LIMIT=5
# DB_LOGIN_FAILURE_WINDOW_SECONDS=60
# DB_LOGIN_FAILURE_BLOCK_SECONDS=30
# DB_TLS_ENABLED=false
# DB_TLS_CERT_FILE=/app/tls/server.crt
# DB_TLS_KEY_FILE=/app/tls/server.key
# DB_REQUIRE_SECURE_TRANSPORT=false
# DB_LOG_MAX_SIZE_MB=20
# DB_LOG_RETENTION_DAYS=7
# DB_AUDIT_ENABLED=false
# DB_AUDIT_PATH=/app/logs/audit.jsonl
# DB_AUDIT_RETENTION_DAYS=7
# DB_BINLOG_ENABLED=false
# DB_BINLOG_PATH=/app/data/binlog.jsonl
# DB_BINLOG_RETENTION_DAYS=7
